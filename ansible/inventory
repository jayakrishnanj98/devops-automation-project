[Jenkins_servers]
jenkins ansible_host=JENKINS_PRIVATE_IP

[kubernetes_control_plane]
master ansible_host=MASTER_PRIVATE_IP

[kubernetes_workers]
worker1 ansible_host=WORKER1_PRIVATE_IP
worker2 ansible_host=WORKER2_PRIVATE_IP

[all:vars]
ansible_user=ec2-user
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_private_key_file=PATH_TO_SSH_PRIVATE_KEY
